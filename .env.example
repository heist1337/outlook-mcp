EWS_ENDPOINT=https://mail.example.com/EWS/Exchange.asmx
EWS_SERVER=mail.example.com
EWS_EMAIL=user@example.com
EWS_USERNAME=user@example.com
EWS_PASSWORD=
EWS_AUTH_TYPE=ntlm

# Generate locally: uv run --locked python -c "import secrets; print(secrets.token_urlsafe(32))"
BRIDGE_API_TOKEN=
DATA_DIR=.local/state

# Optional read capabilities; existing Exchange permissions still apply.
EWS_MAIL_BODY_ENABLED=false
EWS_MAIL_ATTACHMENTS_ENABLED=false
EWS_CALENDAR_CONTEXT_ENABLED=false
EWS_ALLOW_EVENT_SUBJECTS=false
EWS_EXTENDED_READS_ENABLED=false
EWS_SHARED_MAILBOX=

# Writes need a separate, distinct random token and explicit operation groups.
EWS_WRITE_API_TOKEN=
EWS_ENABLED_WRITE_GROUPS=
